NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cocomama
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
AUTH_EMAIL_MODE=console
AUTH_STORAGE_MODE=database
AUTH_OTP_BYPASS_CODE=111111

# Email delivery
# Keep AUTH_EMAIL_MODE=console for local dev logs. Set AUTH_EMAIL_MODE=email after adding SMTP credentials.
# Gmail SMTP: use SMTP_PROVIDER=gmail, your Gmail address as SMTP_USER, and a Google App Password as SMTP_PASS.
# Generic SMTP: use SMTP_PROVIDER=custom and fill SMTP_HOST/SMTP_PORT/SMTP_SECURE.
SMTP_PROVIDER=gmail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM=Cocomama <your-gmail-address@gmail.com>

LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_TEMPERATURE=1
LLM_TOP_P=0.95
LLM_MAX_TOKENS=4096
LLM_ENABLE_THINKING=true
LLM_REASONING_BUDGET=2048
LLM_PROVIDER_RETRY_ATTEMPTS=1
VOICE_GATEWAY_BASE_URL=http://localhost:8010
VOICE_GATEWAY_TIMEOUT_MS=30000
VOICE_MAX_AUDIO_BYTES=8388608
VOICE_TTS_DEFAULT_VOICE=af_sky
IDEMPOTENCY_WINDOW_SECONDS=60
MAX_TOOL_ITERATIONS=6